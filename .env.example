# Tunnel URL (cloudflared/ngrok), must be current and reachable by Twilio
PUBLIC_URL=
PORT=8080

# Any OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# LLM_BACKEND=openai uses the three keys above (Groq). Set to backboard to route via Backboard.
LLM_BACKEND=openai
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_PROVIDER=
BACKBOARD_MODEL=

SERPAPI_KEY=
CURRENCY=CAD
SERP_GL=ca

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set to your own cell to test the multi-call flow, or a judge-run line on bake-off day
PHONE_OVERRIDE=

TOP_K=3
HOLD_ON_CALL=0
TTS_VOICE=Polly.Joanna-Neural
SPEECH_TIMEOUT=auto
MAX_TURNS=6
CALL_TIMEOUT=120
DIAL_RETRIES=1

GUEST_NAME=
JUDGE_EMAIL=

# Email: set RESEND_API_KEY for the fast HTTP path, else SMTP (Gmail app password) is used
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
