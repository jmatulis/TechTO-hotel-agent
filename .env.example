# Tunnel URL (cloudflared/ngrok), must be current and reachable by Twilio
PUBLIC_URL=
PORT=8080

# Backboard: one key, POST /threads/messages. cerebras/gpt-oss-120b measured ~0.8s/turn.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_PROVIDER=cerebras
BACKBOARD_MODEL=openai/gpt-oss-120b

SERPAPI_KEY=

# Google Places API (New): phones + reviews in liteapi_search.py, phone fallback in hotel_search.py
GOOGLE_PLACES_KEY=
# pipeline.py: hotels phoned per round, rounds before giving up
CALL_BATCH=15
# post-call decision: currency we'd pay to save one second of waiting; price band width (share of cheapest)
LATENCY_COST=0.5
SEGMENT_PCT=0.10
MAX_ROUNDS=3
# only hotels within this many km of the city centre (0 = off); result pages, 1 credit each
RADIUS_KM=20
SEARCH_PAGES=1
CURRENCY=CAD
SERP_GL=ca

# ElevenLabs TTS (sponsor stack). Raw TTS only - NOT their Agents product (that's a DQ).
# ELEVEN_MODE: all = every spoken line | opener = only the pre-generated opener | off = Twilio <Say>
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=NOpBlnGInO9m6vDvFkFC
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_FORMAT=mp3_22050_32
ELEVEN_MODE=all
ELEVEN_TIMEOUT=4
# Library voices default to a slow read; these override it. speed is 0.7-1.2.
ELEVEN_SPEED=1.2
ELEVEN_STABILITY=0.5
ELEVEN_SIMILARITY=0.75

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set to your own cell to test the multi-call flow, or a judge-run line on bake-off day
PHONE_OVERRIDE=

TOP_K=3
# 1 = Twilio records calls; the winning call's mp3 is attached to the email
RECORD_CALLS=1
HOLD_ON_CALL=0
TTS_VOICE=Polly.Joanna-Neural
# 1 = the hotel can interrupt the agent mid-sentence; 0 = the agent always finishes
BARGE_IN=0
SPEECH_TIMEOUT=auto
MAX_TURNS=6
# Twilio hangs up after this many seconds connected
CALL_MAX_SECONDS=60
CALL_TIMEOUT=30
DIAL_RETRIES=1

GUEST_NAME=
JUDGE_EMAIL=

# Email: set RESEND_API_KEY for the fast HTTP path, else SMTP (Gmail app password) is used
# organizers' subject: "Team # <N> - Hotel Reservation Confirmed!"
TEAM_NUMBER=
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=


# LiteAPI (hotel prices): https://dashboard.liteapi.travel
LITEAPI_API_KEY=
